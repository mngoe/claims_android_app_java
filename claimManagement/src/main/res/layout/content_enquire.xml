<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="org.openimis.imisclaims.EnquireActivity"
    tools:showIn="@layout/activity_enquire">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Section de recherche -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recherche d'assuré"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2C3E50"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:hint="@string/CHFID">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCHFID"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:fontFamily="sans-serif-medium"
                android:imeOptions="actionGo">
                <requestFocus />
            </com.google.android.material.textfield.TextInputEditText>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="5dp"
            android:contentDescription="@string/Scan"
            android:backgroundTint="@color/colorPrimary"
            app:icon="@drawable/qr_scan"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="@android:color/white"
            style="@style/Widget.MaterialComponents.Button"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGo"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="5dp"
            android:backgroundTint="@color/colorAccent"
            app:icon="@drawable/go_button"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="@android:color/white"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHeadInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp">

        <ImageView
            android:id="@+id/imageView"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
            android:src="@drawable/noimage"
                        android:scaleType="centerCrop" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

        <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                            android:text="ID: "
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvCHFID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/CHFID"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nom: "
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/InsureeName"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sexe: "
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Gender"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Naissance: "
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="#7F8C8D" />

            <TextView
                android:id="@+id/tvDOB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/DOB"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="#2C3E50" />

                    </LinearLayout>

        </LinearLayout>

            </LinearLayout>

    </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Section pour les familles polygames -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvPolygamousSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="#E74C3C"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chefs de sous-familles (Polygame)"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#2C3E50" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cliquez sur un chef de sous-famille pour voir tous les membres de son ménage"
                android:textSize="14sp"
                android:textColor="#7F8C8D"
                android:layout_marginBottom="16dp"
                android:fontStyle="italic" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPolygamousHeads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Liste des membres de famille -->
    <androidx.cardview.widget.CardView
        android:id="@+id/llListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="#27AE60"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Membres de la famille"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#2C3E50" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFamilyMembers"
        android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        <ListView
            android:id="@+id/listView1"
            android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

    </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>


</androidx.core.widget.NestedScrollView>
